# Credentials and user-specific settings
**/.env
**/.env.*
!**/.env.example
# Dependencies, caches, installed runtimes and generated output
**/node_modules/
**/.cache/
**/.runtime/
**/dist/
**/vendor/**/dist/
**/vendor/**/*.js
**/vendor/**/*.d.ts
# Runtime state, logs and validation artifacts
**/var/
**/evidence/
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/*.test
**/*.out
**/coverage/
.DS_Store
.work/

# Cloud site-specific configuration and TLS/basic-auth material
/deploy/cloud/config.yaml
/deploy/cloud/tls/*
/deploy/cloud/auth/*

/deploy/cloud/config.sender.yaml
/deploy/cloud/trpc.sender.yaml

# Python tooling cache
**/__pycache__/
**/*.pyc
