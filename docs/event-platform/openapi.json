  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "webhook": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "app_id": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "id_type": {
            "type": "string"
          },
          "smtp_host": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "smtp_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": []
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "type": "string"
          },
          "weekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 3600
          },
          "notified_seconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 3600
          },
          "ttl_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          }
        },
        "required": [
          "timezone",
          "weekdays",
          "start",
          "end",
          "interval_seconds",
          "notified_seconds",
          "ttl_minutes"
        ]
      },
      "TargetWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "feishu_group",
              "feishu_private",
              "smtp"
            ]
          },
          "version": {
            "type": "integer"
          },
          "credentials": {
            "$ref": "#/components/schemas/Credentials"
          }
        },
        "required": [
          "name",
          "kind",
          "credentials"
        ]
      },
      "TargetRead": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": []
      },
      "SubscriptionWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "room_id": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "target_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "room_id",
          "enabled",
          "policy",
          "target_ids"
        ]
      },
      "TenantWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "max_subscriptions": {
            "type": "integer"
          },
          "max_targets": {
            "type": "integer"
          }
        },
        "required": [
          "name"
        ]
      },
      "MemberWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "owner",
              "admin",
              "operator",
              "viewer"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "ReplayWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": []
      }
    }
  }
}
