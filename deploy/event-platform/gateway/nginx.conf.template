worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
  log_format platform escape=json '{"service":"gateway","gateway":"nginx","request_id":"$request_id","status":$status,"method":"$request_method","duration":$request_time}';
  access_log /dev/stdout platform;
  client_max_body_size 64k;
  client_body_timeout 12s;
  send_timeout 12s;
  limit_req_zone $binary_remote_addr zone=per_ip:10m rate=10r/s;
  limit_req_status 429;
  proxy_connect_timeout 3s;
  proxy_read_timeout 12s;
  proxy_send_timeout 12s;
  proxy_next_upstream off;
  proxy_cache off;
  proxy_set_header X-User "";
  proxy_set_header X-User-ID "";
  proxy_set_header X-Tenant "";
  proxy_set_header X-Tenant-ID "";
  proxy_set_header X-Roles "";
  proxy_set_header X-Authenticated-Subject "";
  proxy_set_header X-Request-ID $request_id;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Host $host;
  ssl_certificate /certs/tls.crt;
  ssl_certificate_key /certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  server { listen 443 ssl default_server; server_name _; return 404; }
  server {
    listen 443 ssl; server_name @API_HOST@;
    location /api/v1/ {
      limit_req zone=per_ip burst=20 nodelay;
      auth_request /_authenticate;
      proxy_pass http://api:8800;
      add_header Cache-Control no-store always;
    }
    location = /_authenticate {
      internal;
      proxy_pass http://api:8800/internal/auth;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header Authorization $http_authorization;
      proxy_method GET;
    }
    location / { return 404; }
  }
  server {
    listen 443 ssl; server_name @AUTH_HOST@;
    location /realms/live/ { proxy_pass http://keycloak:8080; }
    location /resources/ { proxy_pass http://keycloak:8080; }
    location / { return 404; }
  }
  server {
    listen 443 ssl; server_name @GRAFANA_HOST@;
    location / { proxy_pass http://grafana:3000; }
  }
  server { listen 9091; location = /metrics { stub_status; } location / { return 404; } }
}
