# Supply secrets via your deployment secret manager. Do not commit a real .env.
GATEWAY=apisix
CACHE=redis
REDIS_PASSWORD=
EVENT_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
API_HOST=api.localhost
AUTH_HOST=auth.localhost
GRAFANA_HOST=grafana.localhost
TLS_DIR=./generated/certs
PG_PASSWORD=
KC_PG_PASSWORD=
KC_ADMIN_USER=bootstrap-admin
KC_ADMIN_PASSWORD=
GRAFANA_OIDC_SECRET=
EVENT_CREDENTIAL_KEY_ID=k1
EVENT_CREDENTIAL_KEYS=
EVENT_ADMIN_SUBJECTS=
EVENT_RETENTION_DAYS=90
EVENT_SMTP_ALLOWED_HOSTS=
KAFKA_RETENTION_MS=604800000
LOG_RETENTION=336h
TRACE_RETENTION=168h
METRIC_RETENTION=30d
